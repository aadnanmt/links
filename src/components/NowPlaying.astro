---
import { getNowPlaying } from '../lib/lastfm'

const { track, error } = await getNowPlaying()

// silent fail: no env locally or API down → render nothing
if (error || !track) {
	return null
}

function formatTimeAgo(timestamp?: number) {
	if (!timestamp) return ''
	const seconds = Math.max(0, Math.floor(Date.now() / 1000 - timestamp))
	if (seconds < 60) return 'just now'
	const minutes = Math.floor(seconds / 60)
	if (minutes < 60) return `${minutes} minutes ago`
	const hours = Math.floor(minutes / 60)
	if (hours < 24) return `${hours} hours ago`
	const days = Math.floor(hours / 24)
	return `${days} days ago`
}
---

<div class="nowplaying">
	<div class="np-art">
		{track.image ? (
			<img src={track.image} alt={track.artist} />
		) : (
			<svg class="np-note" viewBox="0 0 256 256" aria-hidden="true">
				<path
					fill="currentColor"
					d="M212.92 17.69a8 8 0 0 0-6.86-1.45l-128 32A8 8 0 0 0 72 56v110.08A36 36 0 1 0 88 196v-85.75l112-28v51.83A36 36 0 1 0 216 164V24a8 8 0 0 0-3.08-6.31M52 216a20 20 0 1 1 20-20a20 20 0 0 1-20 20M88 93.75v-31.5l112-28v31.5ZM180 184a20 20 0 1 1 20-20a20 20 0 0 1-20 20"
				/>
			</svg>
		)}
		{track.nowPlaying && (
			<span class="np-live">
				<span class="np-live-ping" />
				<span class="np-live-dot" />
			</span>
		)}
	</div>
	<div class="np-meta">
		<span class="np-label">
			{track.nowPlaying ? 'Now Playing' : `Last Played - ${formatTimeAgo(track.timestamp)}`}
		</span>
		<span class="np-track">{track.name}</span>
		<span class="np-artist">{track.artist}</span>
	</div>
</div>
